@{
    ViewData["Title"] = "الرئيسية";
}

<div class="dashboard-header mb-4">
    <h2 style="color: #4f46e5;">مرحباً، المدير العام 👋</h2>
    <p style="color: #666;">إليك نظرة عامة على الموقع.</p>
</div>

<!-- Dashboard Stats Grid -->
<div class="dashboard-grid"
     style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">

    <!-- Card 1 -->
    <div class="dashboard-card text-center">
        <h3 style="color: #4f46e5; font-size: 2rem;">0</h3>
        <p>إجمالي المواقع</p>
        <i class="fa-solid fa-map-location-dot fa-2x" style="color:#4f46e5;"></i>
    </div>

    <!-- Card 2 -->
    <div class="dashboard-card text-center">
        <h3 style="color: #4f46e5; font-size: 2rem;">0</h3>
        <p>إجمالي العقارات</p>
        <i class="fa-solid fa-building fa-2x" style="color:#4f46e5;"></i>
    </div>

    <!-- Card 3 -->
    <div class="dashboard-card text-center">
        <h3 style="color: #4f46e5; font-size: 2rem;">0</h3>
        <p>طلبات جديدة</p>
        <i class="fa-solid fa-envelope fa-2x" style="color:#4f46e5;"></i>
    </div>

    <!-- Card 4 -->
    <div class="dashboard-card text-center">
        <h3 style="color: #4f46e5; font-size: 2rem;">0</h3>
        <p>زيارات هذا الشهر</p>
        <i class="fa-solid fa-chart-line fa-2x" style="color:#4f46e5;"></i>
    </div>
</div>
