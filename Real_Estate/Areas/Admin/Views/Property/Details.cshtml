                    <div class="specs-grid">
                        <!-- Spec Item -->
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <span class="spec-label">النوع</span>
                            <span class="spec-value">@Model.Type</span>
                        </div>

                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="fa-solid fa-ruler-combined"></i>
                            </div>
                            <span class="spec-label">المساحة (م²)</span>
                            <span class="spec-value">@Model.AreaSize</span>
                        </div>

                        <div class="spec-item">
                            <div class="spec-icon">
