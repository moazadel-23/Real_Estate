@model Real_Estate.Models.Property
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>شقة للبيع فيو مفتوح - السكن الفاخر</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Main Style -->
    <link rel="stylesheet" href="~/css/style.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <style>
        /* Specific page overrides */
        .content-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid #f0f0f0;
        }

        /* Slider Styles */
        .property-slider {
            position: relative;
            width: 75%;
            margin: 0 auto 30px auto;
            /* Centered with bottom margin */
            height: 750px;
            /* Increased height significantly */
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .slider-track {
            display: flex;
            height: 100%;
            transition: transform 0.5s ease-in-out;
        }

        .slide {
            min-width: 100%;
            height: 100%;
            position: relative;
        }

            .slide img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* Navigation Buttons */
        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

            .slider-btn:hover {
                background: rgba(255, 255, 255, 0.9);
                color: var(--primary-color);
            }

        .prev-btn {
            right: 20px;
        }

        .next-btn {
            left: 20px;
        }

        /* Counter Badge */
        .slider-badge {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.6);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 10;
        }

        .main-container {
            grid-template-columns: 1fr !important;
        }

        .property-slider {
            height: 500px;
        }

        /* Specs Horizontal Layout */
        .specs-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: space-between;
        }

        .spec-item {
            flex: 1 1 auto;
            min-width: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 10px;
            transition: 0.3s;
        }

            .spec-item:hover {
                background: #fff;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
                transform: translateY(-3px);
            }

        .action-btn {
            width: 180px; /* قلل/كبر الرقم براحتك */
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .buy-btn {
            background-color: var(--accent-color);
            color: white;
            border-radius: 8px;
            font-weight: bold;
            border: none;
            padding: 12px 25px;
            cursor: pointer;
            transition: 0.3s;
        }

    </style>
</head>

<body>

