        <div class="container footer-container">
            <div class="footer-col">
                <h3>السكن الفاخر</h3>
                <p>منصتك الأولى للبحث عن العقارات الفاخرة والمتميزة.</p>
                <div class="social-links">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="index.html">الرئيسية</a></li>
                    <li><a href="index.html#featured">العقارات</a></li>
                    <li><a href="#">من نحن</a></li>
                    <li><a href="#">اتصل بنا</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <ul style="color:#ccc;">
                    <li><i class="fa-solid fa-phone"></i> +966 50 000 0000</li>
                    <li><i class="fa-solid fa-envelope"></i> info@luxuryhomes.com</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 جميع الحقوق محفوظة - السكن الفاخر</p>
        </div>
    </footer>

    <script src="script.js"></script>

    <!-- Slider Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const track = document.getElementById('sliderTrack');
            const slides = document.querySelectorAll('.slide');
            const nextBtn = document.getElementById('nextBtn');
            const prevBtn = document.getElementById('prevBtn');
            const counter = document.getElementById('slideCounter');

            let currentIndex = 0;
            const totalSlides = slides.length;

            function updateSlider() {
                const width = track.clientWidth;
                // Move track securely
                track.style.transform = `translateX(\${currentIndex * width}px)`; // RTL: Positive X moves Right (showing left content? No.)
                // Standard CSS transform logic:
                // We want to show the Nth slide.
                // In RTL, the flow is Right to Left. slide[0] is at Rightmost. slide[1] is to its left.
                // To show slide[1], we need to move text/content to the Right?
                // Let's rely on standard logic:
                // In RTL mode, flex-direction is row (starts right).
                // So slide 0 is at 0px. Slide 1 is at -width (visually left)?
                // Actually browsers handle transform X directions differently in RTL sometimes.
                // Let's test standard negative standard logic first, or just check standard.
                // If dir=rtl, `translateX(100px)` moves element to the Left? No, usually follows axis.
                // Let's assume standard behavior: slide[0] is at offset 0.
                // To show slide[1], we need to shift the track so slide[1] is in view.
                // If items stack R->L: [Slide 0] [Slide 1] [Slide 2] ...
                // To see Slide 1, we move the track to the Right by 1 width.

                track.style.transform = `translateX(\${currentIndex * 100}%)`;

                counter.textContent = `\${currentIndex + 1} / \${totalSlides}`;
            }

            nextBtn.addEventListener('click', () => {
                // Next image (visually to the left, index + 1)
                currentIndex = (currentIndex + 1) % totalSlides;
                updateSlider();
            });

            prevBtn.addEventListener('click', () => {
                // Prev image
                currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
                updateSlider();
            });

            // Handle window resize
            window.addEventListener('resize', updateSlider);

            // Leaflet Map Init
            var map = L.map('propertyMap').setView([24.7136, 46.6753], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            L.marker([24.7136, 46.6753]).addTo(map)
                .bindPopup('موقع العقار التقريبي')
                .openPopup();
        });
    </script>
</body>

</html>