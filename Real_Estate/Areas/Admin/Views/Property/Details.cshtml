                    </div>

                </div>

                <!-- Prominent Specifications -->
                <div class="content-card specifications-section" style="margin-bottom: 30px;">
                    <h3 style="font-size: 1.3rem; margin-bottom: 25px; color: #333; font-weight: 700; border-right: 4px solid var(--accent-color); padding-right: 15px;">
                        المواصفات البارزة
