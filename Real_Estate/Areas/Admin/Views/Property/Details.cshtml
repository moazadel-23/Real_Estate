@model Real_Estate.Models.Property
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>شقة للبيع فيو مفتوح - السكن الفاخر</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Main Style -->
    <link rel="stylesheet" href="~/css/style.css">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <style>
        /* Specific page overrides */
        .content-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid #f0f0f0;
        }

        /* Slider Styles */
        .property-slider {
            position: relative;
            width: 75%;
            margin: 0 20px 30px auto;
            /* Shifted right with small gap ("Simple difference") */
            height: 450px;
            /* Significantly reduced height */
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .card-aligned {
            width: 75%;
            margin: 0 20px 30px auto;
            /* Shifted right with small gap */
        }

        .slider-track {
            display: flex;
            height: 100%;
            transition: transform 0.5s ease-in-out;
        }

        .slide {
            min-width: 100%;
            height: 100%;
            position: relative;
        }

            .slide img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* Navigation Buttons */
        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(5px);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

            .slider-btn:hover {
                background: rgba(255, 255, 255, 0.9);
                color: var(--primary-color);
            }

        .prev-btn {
            right: 20px;
        }

        .next-btn {
            left: 20px;
        }

        /* Counter Badge */
        .slider-badge {
            position: absolute;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.6);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 10;
        }

        .main-container {
            grid-template-columns: 1fr !important;
        }

        .property-slider {
            height: 500px;
        }

        /* Specs Horizontal Layout */
        .specs-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: space-between;
        }

        .spec-item {
            flex: 1 1 auto;
            min-width: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 10px;
            transition: 0.3s;
        }

            .spec-item:hover {
                background: #fff;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
                transform: translateY(-3px);
            }

        .action-btn {
            width: 180px;
            /* قلل/كبر الرقم براحتك */
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .buy-btn {
            background-color: var(--accent-color);
            color: white;
            border-radius: 8px;
            font-weight: bold;
            border: none;
            padding: 12px 25px;
            cursor: pointer;
            transition: 0.3s;
        }

        .property-slider {
            overflow: hidden;
            /* عشان الصور اللي بره الكادر ما تظهرش */
            position: relative;
        }

        .slider-track {
            display: flex;
            /* عشان الصور تيجي جنب بعض */
            transition: transform 0.5s ease-in-out;
            /* حركة التقليب السلسة */
            width: 100%;
        }

        .slide {
            min-width: 100%;
            /* كل صورة تاخد العرض الكامل */
            box-sizing: border-box;
        }

        .location-modern {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
        }

        .loc-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #ffffff;
            padding: 12px 16px;
            border-radius: 14px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            min-width: 180px;
        }

            .loc-item i {
                font-size: 1.5rem;
                color: var(--accent-color);
            }

            .loc-item small {
                display: block;
                font-size: 0.75rem;
                color: #888;
                margin-bottom: 2px;
            }

            .loc-item span {
                font-size: 1rem;
                font-weight: 600;
                color: #333;
            }

        /* Layout */
        .property-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        /* Cards */
        .content-card {
            padding: 18px;
            border-radius: 14px;
        }

        /* Right Card */
        .prop-info-card {
            position: relative;
        }

        /* Share */
        .share-btn {
            position: absolute;
            top: 16px;
            left: 16px;
            color: #888;
            transition: 0.3s;
        }

            .share-btn:hover {
                color: var(--accent-color);
                transform: rotate(-10deg) scale(1.1);
            }

        /* Price */
        .prop-price {
            display: flex;
            justify-content: flex-end;
            gap: 4px;
            direction: ltr;
        }

        .currency {
            font-size: 0.8rem;
            color: #777;
        }

        .price {
            font-size: 1.6rem;
            font-weight: 800;
        }

        /* Title */
        .prop-title {
            font-size: 1.2rem;
            margin: 10px 0 14px;
        }

        /* Location */
        .location-modern.minimal {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .loc-item {
            font-size: 0.8rem;
            background: linear-gradient(135deg, #f7f7f7, #fff);
            padding: 6px 10px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: 0.25s;
        }

            .loc-item i {
                color: var(--accent-color);
            }

            .loc-item:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
            }

        /* Buttons */
        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 16px;
        }

        .action-btn {
            font-size: 0.8rem;
            padding: 7px 16px;
            border-radius: 8px;
            transition: 0.25s;
        }

            .action-btn:hover {
                transform: translateY(-2px);
            }

        /* Specs */
        .specifications-section {
            animation: fadeSlide 0.5s ease;
        }

        .spec-title {
            font-size: 1.05rem;
            margin-bottom: 14px;
            border-right: 3px solid var(--accent-color);
            padding-right: 10px;
        }

        .specs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .spec-item {
            font-size: 0.8rem;
            background: #fafafa;
            padding: 10px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.25s;
        }

            .spec-item i {
                color: var(--accent-color);
            }

            .spec-item:hover {
                background: #fff;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            }

        /* Animation */
        @@keyframes fadeSlide {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Layout */
        .property-layout {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        /* RIGHT - Property Info */
        .property-right {
            flex: 1 1 60%;
        }

        .prop-info-card {
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
            background-color: #fff;
            position: relative;
            transition: transform 0.3s ease;
        }

            .prop-info-card:hover {
                transform: translateY(-3px);
            }

        /* Share Button */
        .share-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.85);
            padding: 10px;
            border-radius: 50%;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: 0.3s;
        }

            .share-btn:hover {
                transform: scale(1.1);
            }

        /* Price */
        .prop-price {
            display: flex;
            align-items: baseline;
            justify-content: flex-end;
            gap: 8px;
            font-family: 'Segoe UI', sans-serif;
            margin-bottom: 12px;
        }

            .prop-price .currency {
                font-size: 1.2rem;
                font-weight: 600;
                color: #333;
            }

            .prop-price .price {
                font-size: 2rem;
                font-weight: 800;
                color: #222;
            }

        /* Title */
        .prop-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 15px;
        }

        /* Location */
        .location-modern.minimal {
            display: flex;
            gap: 20px;
            font-size: 0.95rem;
            color: #666;
            margin-bottom: 20px;
        }

        .location-modern .loc-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
        }

        .action-btn {
            flex: 1;
            padding: 14px 20px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-primary.action-btn {
            background: linear-gradient(135deg, #ff8a00, #ff5e00);
            color: #fff;
            border: none;
            box-shadow: 0 10px 25px rgba(255, 94, 0, 0.3);
        }

            .btn-primary.action-btn:hover {
                transform: translateY(-3px) scale(1.03);
            }

        .btn-outline.action-btn {
            background: #fff;
            border: 2px solid #eee;
            color: #333;
        }

            .btn-outline.action-btn:hover {
                background: #f9f9f9;
                border-color: #ff5e00;
                color: #ff5e00;
                transform: translateY(-2px);
            }

        /* LEFT - Specifications */
        .property-left {
            flex: 1 1 35%;
        }

        .specifications-section {
            padding: 20px;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            background-color: #fff;
        }

        .spec-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: #333;
            border-right: 4px solid #ff5e00;
            padding-right: 12px;
            margin-bottom: 20px;
        }

        .specs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .spec-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
            color: #555;
        }

            .spec-item i {
                color: #ff5e00;
            }

        /* Description & Map Cards */
        .content-card {
            padding: 20px;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            background-color: #fff;
            margin-bottom: 30px;
        }

            .content-card h3 {
                font-size: 1.3rem;
                font-weight: 700;
                color: #333;
                border-right: 4px solid #ff5e00;
                padding-right: 12px;
                margin-bottom: 15px;
            }

            .content-card p {
                color: #555;
                line-height: 1.7;
                text-align: justify;
            }

        /* Responsive */
        /* Responsive */
        @@media (max-width: 1024px) {
            .property-layout {
                flex-direction: column;
            }

            .property-right,
            .property-left {
                flex: 1 1 100%;
            }
        }

        /* Fixed WhatsApp Card to match reference */
        .whatsapp-card {
            position: fixed;
            bottom: 30px;
            left: 30px;
            z-index: 9999;
            width: 280px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            font-family: 'Cairo', sans-serif;
            border-top: 5px solid #5a4b9f;
            /* Purple top border */
            text-align: center;
            opacity: 0;
            animation: slideInLeft 0.5s forwards 1s;
        }

        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .wa-header {
            padding: 15px 10px;
            font-size: 0.95rem;
            font-weight: 700;
            color: #333;
        }

        .wa-body {
            padding: 0 15px 15px 15px;
        }

        .wa-btn-large {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #4cc94a;
            /* WhatsApp Green */
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 1rem;
            transition: 0.3s;
            box-shadow: 0 4px 10px rgba(76, 201, 74, 0.3);
        }

            .wa-btn-large:hover {
                background: #43b541;
                transform: translateY(-2px);
            }

        .wa-footer {
            background: #dceef9;
            padding: 8px;
            font-size: 0.75rem;
            color: #555;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        /* Update media query for responsive visibility */
        @@media (max-width: 768px) {
            .whatsapp-card {
                width: 50px;
                height: 50px;
                border: none;
                border-radius: 50%;
                top: auto;
                bottom: 20px;
                left: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #25D366;
                padding: 0;
            }

            .wa-header,
            .wa-footer,
            .wa-btn-text {
                display: none;
            }

            .wa-body {
                padding: 0;
                width: 100%;
                height: 100%;
            }

            .wa-btn-large {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                padding: 0;
                box-shadow: none;
                background: transparent;
            }

                .wa-btn-large i {
                    font-size: 1.8rem;
                }
        }

        @@keyframes floatBubble {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }


    </style>
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="nav-right-group" style="display: flex; align-items: center;">

                <a asp-area="" asp-controller="Property" asp-action="Index" class="home-btn"
                   style="color:var(--primary-color); font-weight:400; margin-right:70px; font-size:1.2rem; padding:6px 14px;">
                    <i class="fa-solid fa-arrow-right"></i> العودة للرئيسية
                </a>

            </div>

            <div class="nav-buttons" style="display: flex !important; align-items: center; gap: 15px;">
                <a href="favorites.html" class="btn-outline"
                   style="border-radius:60%; width:40px; height:40px; display:flex; align-items:center; justify-content:center; padding:0;">
                    <i class="fa-solid fa-heart"></i>
                </a>
                <a href="cart.html" class="btn-outline"
                   style="border-radius:60%; width:40px; height:40px; display:flex; align-items:center; justify-content:center; padding:0;">
                    <i class="fa-solid fa-cart-shopping"></i>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container" style="padding-top: 100px; padding-bottom: 50px;">
        <div class="main-container" style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">


            <!-- Main Content (Right) -->
            <div class="details-col">


                <!-- Image Slider (Moved Inside Column & Made Taller) -->
                <div class="property-slider">
                    <div class="slider-track" id="sliderTrack">
                        <!-- Slide 1 -->
                        <div class="slide">
                            <img src="@Url.Content("~/img/" + Model.MainImg)" alt="View 1">
                        </div>

                        <!-- Slides 2 -->
                        @if (Model.PropertySubImgs != null && Model.PropertySubImgs.Count > 0)
                        {
                            foreach (var img in Model.PropertySubImgs)
                            {
                                <div class="slide">
                                    <img src="@Url.Content("~/img/" + img.PropertyImgs)" alt="Property View">

                                </div>
                            }
                        }

                    </div>

                    <!-- Controls -->
                    <button class="slider-btn prev-btn" id="prevBtn">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    <button class="slider-btn next-btn" id="nextBtn">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>

                    <!-- Badge -->
                    <div class="slider-badge">
                        <i class="fa-solid fa-camera"></i> <span id="slideCounter"></span>
                    </div>
                </div>
                <!-- Main Info Card -->
                <div class="content-card prop-info-card card-aligned">

                    <a href="#" class="share-btn">
                        <i class="fa-solid fa-share-nodes"></i>
                    </a>

                    <div class="prop-price">
                        <span class="currency">ج.م</span>
                        <span class="price">@Model.Price.ToString("N0")</span>
                    </div>

                    <h1 class="prop-title">@Model.Title</h1>

                    <div class="location-modern minimal">
                        <div class="loc-item">
                            <i class="fa-solid fa-city"></i>
                            <span>@Model.Location!.City</span>
                        </div>
                        <div class="loc-item">
                            <i class="fa-solid fa-map"></i>
                            <span>@Model.Location!.Area</span>
                        </div>
                        <div class="loc-item">
                            <i class="fa-solid fa-road"></i>
                            <span>@Model.Location!.Street</span>
                        </div>
                    </div>

                    <div class="action-buttons">
                        <button class="btn btn-primary action-btn">إضافة للسلة</button>
                        <button class="btn btn-outline action-btn">اشتري الآن</button>
                    </div>

                </div>

                <!-- Specs Card UNDER Main Card -->
                <div class="content-card specifications-section card-aligned" style="margin-top: 20px;">

                    <h3 class="spec-title">المواصفات</h3>

                    <div class="specs-grid"
                         style="display: flex; gap: 15px; flex-wrap: wrap; justify-content: space-between;">
                        <div class="spec-item">
                            <i class="fa-solid fa-building"></i>
                            <span>@Model.Type</span>
                        </div>

                        <div class="spec-item">
                            <i class="fa-solid fa-ruler-combined"></i>
                            <span>@Model.AreaSize م²</span>
                        </div>

                        <div class="spec-item">
                            <i class="fa-solid fa-bed"></i>
                            <span>@Model.Bedrooms غرف</span>
                        </div>

                        <div class="spec-item">
                            <i class="fa-solid fa-bath"></i>
                            <span>@Model.Bathrooms حمام</span>
                        </div>
                    </div>

                </div>


                <!-- Description -->
                <div class="content-card card-aligned">
                    <h3 style="font-size: 1.3rem; margin-bottom: 15px; color: #333; font-weight: 700; border-right: 4px solid var(--accent-color); padding-right: 15px;">
                        وصف العقار
                    </h3>
                    <p style="color:#555; line-height:1.8; text-align:justify;">
                        @Model.Description

                    </p>
                </div>

                <!-- Map -->
                <div class="content-card card-aligned">
                    <h3 style="font-size: 1.3rem; margin-bottom: 15px; color: #333; font-weight: 700; border-right: 4px solid var(--accent-color); padding-right: 15px;">
                        الموقع
                    </h3>
                    <div id="propertyMap" style="height: 350px; width: 100%; border-radius: 10px; z-index: 1;"></div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {

                        // لو العقار له Location استخدمه، غير كده قيمة افتراضية
                        const lat = @(Model.Location != null ? Model.Location.Latitude : 30.0444)
                        const lng = @(Model.Location != null ? Model.Location.Longitude : 31.2357);

                        // إنشاء الخريطة
                        var map = L.map('propertyMap').setView([lat, lng], 15);

                        // تحميل الخريطة
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '© OpenStreetMap'
                        }).addTo(map);

                        // Marker على موقع العقار
                        L.marker([lat, lng]).addTo(map)
                            .bindPopup('<b>@Model.Title</b><br>موقع العقار')
                            .openPopup();
                    });
                </script>


            </div>

            <!-- Sidebar (Left) -->
            <div class="sidebar-col">

                <!-- Agency Card -->
                <div class="agent-card content-card card-aligned"
                     style="text-align: right; padding: 25px; margin-bottom: 20px;">
                    <h4 style="margin-bottom: 20px; font-size: 1.1rem; color: #333; font-weight: 700;">
                        مدرجة من قبل
                        وكالة
                    </h4>

                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                        <div>
                            <span style="font-weight: 700; font-size: 1.1rem; color: #000; display: block;">
                                New
                                Avenue
                            </span>
                            <div style="color: #888; font-size: 0.8rem;">
                                عضو منذ مارس 2024
                            </div>
                        </div>

                        <img src="https://ui-avatars.com/api/?name=New+Avenue&background=0D8ABC&color=fff"
                             style="width: 50px; height: 50px; border-radius: 5px;" alt="Agency Logo">
                    </div>

                </div>

