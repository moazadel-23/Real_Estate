                        </div>
                        <!-- Slide 3 -->
                        <div class="slide">
                            <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=1200&q=80"
                                 alt="View 3">
                        </div>
                        <!-- Slide 4 -->
