            <div class="row" style="margin-top: 20px;">
                <div class="form-group" style="grid-column: 1/-1;">
                    <label style="font-weight: bold; color: var(--primary); margin-bottom: 10px; display: block;">
                        الموقع على الخريطة (GPS)
                    </label>
                    <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                        <input type="hidden" id="gpsLat" name="Latitude">
                        <input type="hidden" id="gpsLng" name="Longitude">

                        <button type="button" class="btn btn-outline" id="getLocationBtn"
                                style="white-space: nowrap; background: #f0f4f8; border: 1px solid #0d2c52; color: #0d2c52; padding: 10px 20px; border-radius: 8px; cursor: pointer; transition: 0.3s;">
                            <i class="fa-solid fa-location-crosshairs"></i> تحديد موقعي الحالي
                        </button>
                    </div>

                    <div id="miniMap" style="height: 300px; width: 100%; border-radius: 12px; border: 2px solid #eee; z-index: 1;"></div>
                    <p style="font-size: 0.8rem; color: #888; margin-top: 8px;">
                        <i class="fa-solid fa-circle-info"></i> يمكنك سحب العلامة الزرقاء لتحديد موقع العقار بدقة.
                    </p>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    // 1. تعريف الإحداثيات الافتراضية (مثلاً القاهرة)
                    let defaultLat = 30.0444;
                    let defaultLng = 31.2357;

                    // 2. إعداد الخريطة المصغرة
                    const miniMap = L.map('miniMap').setView([defaultLat, defaultLng], 13);

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap'
                    }).addTo(miniMap);

                    // 3. إضافة ماركر قابل للسحب (Draggable Marker)
                    let marker = L.marker([defaultLat, defaultLng], {
                        draggable: true
                    }).addTo(miniMap);

                    // وظيفة لتحديث الـ Inputs المخفية عند تغيير الموقع
                    function updateGpsInputs(lat, lng) {
                        document.getElementById('gpsLat').value = lat.toFixed(6);
                        document.getElementById('gpsLng').value = lng.toFixed(6);
                        console.log("GPS Updated:", lat, lng);
                    }

                    // تحديث الموقع عند سحب الماركر باليد
                    marker.on('dragend', function (e) {
                        const position = marker.getLatLng();
                        updateGpsInputs(position.lat, position.lng);
                    });

                    // تحديث الموقع عند الضغط على أي مكان في الخريطة
                    miniMap.on('click', function (e) {
                        marker.setLatLng(e.latlng);
                        updateGpsInputs(e.latlng.lat, e.latlng.lng);
                    });

                    // 4. وظيفة زرار "تحديد موقعي الآن"
                    const getLocationBtn = document.getElementById('getLocationBtn');
                    getLocationBtn.addEventListener('click', function () {
                        if (navigator.geolocation) {
                            // إظهار حالة تحميل بسيطة على الزرار
                            const originalContent = getLocationBtn.innerHTML;
                            getLocationBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري التحديد...';

                            navigator.geolocation.getCurrentPosition(function (position) {
                                const lat = position.coords.latitude;
                                const lng = position.coords.longitude;

                                // نقل الخريطة والماركر للموقع الجديد
                                miniMap.setView([lat, lng], 16);
                                marker.setLatLng([lat, lng]);

                                // تحديث القيم المخفية
                                updateGpsInputs(lat, lng);

                                // إرجاع شكل الزرار
                                getLocationBtn.innerHTML = originalContent;
                                alert("تم تحديد موقعك بنجاح!");

                            }, function (error) {
                                getLocationBtn.innerHTML = originalContent;
                                alert("عذراً، لم نتمكن من الوصول لموقعك. تأكد من تفعيل الـ GPS في المتصفح.");
                            });
                        } else {
                            alert("متصفحك لا يدعم خاصية تحديد الموقع.");
                        }
                    });
                });
            </script>


                <div class="row">
                    <div class="form-group">
                        <label>عدد الغرف</label>
