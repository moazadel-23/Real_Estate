            <p style="color: #666;">قم بتحديث تفاصيل العقار للحفاظ على دقة المعلومات</p>
        </div>

        <!-- Form Container -->
        <form asp-action="Edit" asp-controller="Property" method="post" enctype="multipart/form-data"
              class="form-section fade-in delay-1">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MainImg" />


            <h3 style="margin-bottom: 25px; color: var(--primary-color);">بيانات العقار الأساسية</h3>

            <div class="upload-area" id="imageUpload" style="position: relative; cursor: pointer;">
                <input type="file" hidden id="mainImgInput" name="MainImg" accept="image/*" />

                @if (!string.IsNullOrEmpty(Model.MainImg))
                {
                    <img id="previewImg" src="~/img/@Model.MainImg" width="150"
                         style="margin-top:10px; border-radius:8px;" />
                }
                else
                {
                    <p style="color:#999;">اضغط هنا لاختيار الصورة الرئيسية</p>
                }
            </div>

            <script>
                              const uploadArea = document.getElementById('imageUpload');
                const fileInput = document.getElementById('mainImgInput');

                uploadArea.addEventListener('click', () => fileInput.click());

                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            if (previewImg) {
                                previewImg.src = e.target.result;
                            } else {
                                const img = document.createElement('img');
                                img.id = 'previewImg';
                                img.src = e.target.result;
                                img.width = 150;
                                img.style.marginTop = '10px';
                                img.style.borderRadius = '8px';
                                uploadArea.appendChild(img);
                            }
                        }
                        reader.readAsDataURL(file);
                    }
                });
            </script>

            <div class="upload-area-container" style="border: 2px dashed #ddd; border-radius: 12px; padding: 20px; background: #fafafa;">
                <div class="upload-area" id="galleryUpload" style="text-align: center; cursor: pointer; padding: 20px;">
                    <i class="fa-regular fa-images" style="font-size: 3rem; color:#ccc;"></i>
                    <h3 style="font-size: 1.2rem; color: #555;">صور المعرض الإضافية</h3>
                    <p style="color: #888; font-size: 0.9rem;">اضغط هنا لاختيار أو إضافة صور جديدة</p>

                    <input type="file" hidden id="galleryInput" name="SubImgFiles" multiple />
                    <input type="hidden" id="deletedSubImgs" name="DeletedSubImgs" />


                </div>

                <div id="galleryPreview" class="gallery-grid" style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px;">

                    @if (Model.PropertySubImgs != null && Model.PropertySubImgs.Count > 0)
                    {
                        @foreach (var item in Model.PropertySubImgs)
                        {
                            <div class="gallery-item existing-item" id="existing-@item.Id" style="position: relative; display: inline-block;">
                                <img src="@Url.Content("~/img/" + item.PropertyImgs)" style="width:110px; height:110px; object-fit:cover; border-radius:10px; border:2px solid #eee;" />
                                <button type="button" class="remove-btn" onclick="removeExistingImage('@item.Id')"
                                        style="position:absolute; top:-8px; right:-8px; background:#ff4757; color:white; border:none; border-radius:50%; width:24px; height:24px; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                                    <i class="fa-solid fa-times" style="font-size: 12px;"></i>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>

            <script>
                let dataTransfer = new DataTransfer();

                const galleryUpload = document.getElementById('galleryUpload');
                const galleryInput = document.getElementById('galleryInput');
                const galleryPreview = document.getElementById('galleryPreview');
                const deletedInput = document.getElementById('deletedSubImgs');

                let uploadedGalleryFiles = []; // لتخزين الملفات الجديدة فقط
                let deletedIds = []; // لتخزين IDs الصور القديمة المطلوب حذفها

                // 1. فتح نافذة الاختيار
                galleryUpload.addEventListener('click', (e) => {
                    if (e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        galleryInput.click();
                    }
                });

                // 2. معالجة اختيار ملفات جديدة
                galleryInput.addEventListener('change', function () {
                    const newFiles = Array.from(this.files);
                                   newFiles.forEach(file => {
                    uploadedGalleryFiles.push(file);
                    dataTransfer.items.add(file);
                });

                galleryInput.files = dataTransfer.files;
                renderNewImages();

                    this.value = ''; // Reset input to allow choosing same file again
                });

                // 3. حذف صورة موجودة مسبقاً (من الداتابيز)
                function removeExistingImage(id) {
                    if (confirm('هل أنت متأكد من حذف هذه الصورة نهائياً؟')) {
                        // إخفاء العنصر من الشاشة
                        const element = document.getElementById('existing-' + id);
                        if (element) element.remove();

                        // إضافة الـ ID لقائمة الحذف
                        deletedIds.push(id);
                        deletedInput.value = deletedIds.join(',');
                    }
                }

                // 4. عرض الصور الجديدة المختار حالياً
                function renderNewImages() {
                    // نمسح فقط الصور "الجديدة" المعروضة عشان لا نكررها، أو نمسح الكل ونعيد بناء المعرض
                    // الأفضل نمسح العناصر التي تحمل كلاس 'new-upload' فقط
                    document.querySelectorAll('.new-upload').forEach(el => el.remove());

                    uploadedGalleryFiles.forEach((file, index) => {
                        const reader = new FileReader();
                        reader.onload = (e) => {
                            const div = document.createElement('div');
                            div.className = 'gallery-item new-upload';
                            div.style.position = 'relative';
                            div.style.display = 'inline-block';

                            div.innerHTML = `
                                <img src="${e.target.result}" style="width:110px; height:110px; object-fit:cover; border-radius:10px; border:2px solid #007bff;" />
                                <button type="button"
                                        style="position:absolute; top:-8px; right:-8px; background:#ff4757; color:white; border:none; border-radius:50%; width:24px; height:24px; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                                    <i class="fa-solid fa-times" style="font-size: 12px;"></i>
                                </button>
                                <span style="position:absolute; bottom:5px; left:5px; background:rgba(0,123,255,0.8); color:white; font-size:10px; padding:2px 5px; border-radius:4px;">جديد</span>
                            `;

                            // إضافة وظيفة الحذف للصورة الجديدة
                                           div.querySelector('button').onclick = (evt) => {
                    evt.stopPropagation();

                    uploadedGalleryFiles.splice(index, 1);

                    dataTransfer = new DataTransfer();
                    uploadedGalleryFiles.forEach(f => dataTransfer.items.add(f));
                    galleryInput.files = dataTransfer.files;

                    renderNewImages();
                };


                            galleryPreview.appendChild(div);
                        };
                        reader.readAsDataURL(file);
                    });
                }
            </script>

