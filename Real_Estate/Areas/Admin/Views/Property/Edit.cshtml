    <style>
        :root {
            --sidebar-width: 280px;
        }

        body {
            background-color: #f4f6f9;
        }

        /* Sidebar Styles */
        .admin-sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--primary-color);
            color: white;
            padding: 20px;
            transition: var(--transition);
            z-index: 1000;
            overflow-y: auto;
        }

        .sidebar-header {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }

            .sidebar-logo span {
                color: var(--accent-color);
            }

        .sidebar-menu {
            list-style: none;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 5px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 15px;
            border-radius: 8px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
        }

            .menu-link:hover,
            .menu-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                color: white;
            }

            .menu-link span {
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .menu-arrow {
            font-size: 0.8rem;
            transition: transform 0.3s ease;
        }

        /* Submenu */
        .submenu {
            list-style: none;
            padding-right: 35px;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }

            .submenu.open {
                max-height: 500px;
            }

        .submenu-item {
            margin: 5px 0;
        }

        .submenu-link {
            display: block;
            padding: 8px 10px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            text-decoration: none;
            border-radius: 5px;
            transition: var(--transition);
        }

            .submenu-link:hover {
                color: var(--accent-color);
                background: rgba(255, 255, 255, 0.05);
            }

        .menu-link.expanded .menu-arrow {
            transform: rotate(-90deg);
        }

        /* Main Content */
        .main-content {
            margin-right: var(--sidebar-width);
            padding: 30px;
            transition: margin-right 0.3s ease;
        }



        /* --- Form specific additional styles --- */
        .form-section {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            margin-top: 20px;
            position: relative;
            z-index: 10;
            max-width: 600px;
            /* Reduced width */
            margin-left: auto;
            /* Centering */
            margin-right: auto;
            /* Centering */
        }

        .upload-area {
            border: 2px dashed #ddd;
            border-radius: 10px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 30px;
        }

            .upload-area:hover {
                border-color: var(--accent-color);
                background: #fafafa;
            }

        .upload-icon {
            font-size: 3rem;
            color: #ddd;
            margin-bottom: 10px;
        }

        .row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .gallery-preview {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            margin-top: 20px;
        }


        .admin-sidebar {
            transform: translateX(100%);
        }

        .main-content {
            margin-right: 0;
        }

        .admin-sidebar.active {
            transform: translateX(0);
        }

        .sidebar-toggle-btn {
            display: block;
        }



        .row {
            grid-template-columns: 1fr;
        }


        .gallery-preview img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        /* Enhanced Form Inputs */
        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 700;
                color: var(--primary-color);
                /* Stronger color */
                font-size: 0.95rem;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                width: 100%;
                padding: 8px 12px;
                /* Smaller size */
                border: 2px solid #ccc;
                /* Stronger border */
                border-radius: 8px;
                /* Nice design */
                background-color: #f8f9fa;
                font-size: 0.9rem;
                color: #333;
                font-family: inherit;
                transition: all 0.3s ease;
            }

                .form-group input:focus,
                .form-group select:focus,
                .form-group textarea:focus {
                    border-color: var(--accent-color);
                    background-color: #fff;
                    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
                    outline: none;
                }

                .form-group input:hover,
                .form-group select:hover,
                .form-group textarea:hover {
                    border-color: #999;
                }
    </style>
</head>

