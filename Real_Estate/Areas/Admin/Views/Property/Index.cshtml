        <div class="hero-content">
            <div class="typewriter-container">
                <h1 class="typewriter">مرحبا بك في السكنالفاخر</h1>
            </div>

            <!-- Search Box Moved Below Hero -->
            <!-- Stats (Moved Inside Hero) -->
            <!-- Stats Removed -->
        </div>
    </header>

    <!-- Search Section -->
    <div class="search-container-overlap"
         style="position: relative; margin-top: -110px; margin-bottom: 20px; z-index: 10; padding: 0 15px;">
        <div class="search-box fade-in delay-2"
             style="width: 100%; max-width: 600px; margin: 0 auto; box-shadow: 0 15px 40px rgba(0,0,0,0.15);">
            <form id="searchForm" method="get" asp-area="Admin" asp-controller="Property" asp-action="Index">

                <div class="search-wrapper">
                    <div class="input-container">
                        <i class="fa-solid fa-home"></i>
                        <select name="type" id="typeSelect">
                            <option value="">كل الأنواع</option>
                            <option value="apartment">شقة</option>
                            <option value="villa">فيلا</option>
                            <option value="office">مكتب</option>
                            <option value="chalet">شاليه</option>
                            <option value="palace">قصر</option>
                        </select>
                    </div>
                    <div class="input-divider"></div>
                    <div class="input-container">
                        <i class="fa-solid fa-dollar-sign"></i>

                        <select name="priceRange" id="priceSelect">
                            <option value="">السعر</option>
                            <option value="low">أقل من 1 مليون</option>
                            <option value="medium">1 - 3 مليون</option>
                            <option value="high">أكثر من 3 مليون</option>
                        </select>
                        <script>
                            // بعد تحميل الصفحة
                            window.addEventListener('DOMContentLoaded', function () {
                                const selectedType = '@ViewBag.SelectedType';
                                const selectedPrice = '@ViewBag.SelectedPrice';

                                if (selectedType) {
                                    document.getElementById('typeSelect').value = selectedType;
                                }

                                if (selectedPrice) {
                                    document.getElementById('priceSelect').value = selectedPrice;
                                }
                            });
                        </script>

                    </div>
                    <button type="submit" class="search-btn-icon">
                        <i class="fa-solid fa-search"></i>
                    </button>
                </div>
            </form>

            <script>
                // كود الحفاظ على القيم المختارة بعد البحث
                document.getElementById('typeSelect').value = '@ViewBag.SelectedType' || "";
                document.getElementById('priceSelect').value = '@ViewBag.SelectedPrice' || "";
            </script>
        </div>
    </div>

    <!-- Categories Marquee Section -->
