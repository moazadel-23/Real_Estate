    <!-- Featured Properties -->
    <section class="section" id="featured">
        <div class="container">
            <div class="section-header">

                <div class="properties-grid" id="propertiesContainer">
                    <!-- Static Properties (Template for Loop) -->
                    <!-- Item 1 -->
                    @foreach (var item in Model)
                    {
                        <div class="property-card">
                            <div class="card-image">
                                @if (User?.Identity?.IsAuthenticated == true)
                                {
                                <form asp-area="Customer"
                                      asp-controller="Favorite"
                                      asp-action="AddToFavorite"
                                      method="post">

                                    <input type="hidden" name="PropertyId" value="@item.Id" />
                                    @Html.AntiForgeryToken()

                                    <button class="card-fav-btn fav-btn-@item.Id" type="submit">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>

                                </form>
                                }



                                <a href="@Url.Action("Details", "Property", new { area = "Admin", id = item.Id })">
                                    <span class="card-badge">@item.Type</span>
                                    <img src="/img/@item.MainImg" alt="Property Image" />
                                </a>
                            </div>

                            <div class="card-content">
                                <div class="card-header"
                                     style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">

                                    <div class="prop-price">
                                        <span class="price">@item.Price.ToString("N0")</span>
                                        <span class="currency">ج.م</span>
                                    </div>
                                    <span class="card-floor" style="font-size:0.8rem;color:#777;">
                                        <i class="fa-solid fa-layer-group"></i> @item.Floor
                                    </span>
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title" dir="auto">@item.Title</h3>
                                </div>

                                @{
                                    TimeSpan diff = DateTime.Now - item.CreatedAt;
                                    string timeAgo;

                                    if (diff.TotalDays >= 1)
                                    {
                                        timeAgo = Math.Floor(diff.TotalDays) + (Math.Floor(diff.TotalDays) > 1 ? " days ago" : " day ago");
                                    }
                                    else if (diff.TotalHours >= 1)
                                    {
                                        timeAgo = Math.Floor(diff.TotalHours) + (Math.Floor(diff.TotalHours) > 1 ? " hours ago" : " hour ago");
                                    }
                                    else if (diff.TotalMinutes >= 1)
                                    {
                                        timeAgo = Math.Floor(diff.TotalMinutes) + (Math.Floor(diff.TotalMinutes) > 1 ? " minutes ago" : " minute ago");
                                    }
                                    else
                                    {
                                        timeAgo = "just now";
                                    }
                                }
                                <span class="property-time">@timeAgo</span>


                                <div class="card-features">
                                    <div class="feature" title="غرف النوم">
                                        <i class="fa-solid fa-bed"></i>
                                        <span>@item.Bedrooms</span>
                                    </div>
                                    <div class="feature" title="المساحة">
                                        <i class="fa-solid fa-ruler-combined"></i>
                                        <span>@item.AreaSize</span>
                                    </div>
                                    <div class="spec-item" title="حمام">
                                        <i class="fa-solid fa-bath"></i>
                                        <span>@item.Bathrooms</span>
                                    </div>
                                </div>

                           
                            </div>
                        </div>
                    }
                </div>

                <!-- Button removed since we show all properties -->
            </div>
		</div>
    </section>
    <div class="pagination">
        <div class="pagination">

            <!-- السهم لليسار -->
            @if (ViewBag.CurrentPage > 1)
            {
                <a class="page-btn" href="@Url.Action("Index", "Property", new { page = ViewBag.CurrentPage - 1 })">&laquo;</a>
            }
            else
            {
                <span class="page-btn disabled">&laquo;</span>
            }

            <!-- أرقام الصفحات -->
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                if (i == ViewBag.CurrentPage)
                {
                    <span class="page-btn active">@i</span>
                }
                else
                {
                    <a class="page-btn" href="@Url.Action("Index", "Property", new { page = i })">@i</a>
                }
            }

            <!-- السهم لليمين -->
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a class="page-btn" href="@Url.Action("Index", "Property", new { page = ViewBag.CurrentPage + 1 })">&raquo;</a>
            }
            else
            {
                <span class="page-btn disabled">&raquo;</span>
            }

        </div>


    </div>

    <!-- Login Modal -->
