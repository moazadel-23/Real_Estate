@model IEnumerable<Real_Estate.Models.Property>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <style>
        .btn-post-ad {
            background-color: #e60000 !important;
            color: #ffffff !important;
            display: inline-block;
            /* صغرنا الـ padding عشان الزرار يلم نفسه */
            padding: 8px 20px;
            /* صغرنا الخط */
            font-size: 15px;
            font-weight: 700;
            text-decoration: none !important;
            /* قللنا الانحناء عشان يناسب الحجم الجديد */
            border-radius: 8px;
            border: none !important;
            font-family: sans-serif;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-post-ad:hover {
                background-color: #cc0000 !important;
            }

        .social-btn {
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            max-width: 350px;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 10px;
        }

        /* Google button */
        .google-btn {
            background: #fff;
            color: #000;
            border: 1px solid #ccc;
        }

            .google-btn:hover {
                background: #f7f7f7;
                border-color: #db4437;
                color: #db4437;
            }

        /* Facebook button */
        .facebook-btn {
            background: #1877f2;
            color: #fff;
            border: 1px solid #1877f2;
        }

            .facebook-btn:hover {
                background: #145dbf;
                border-color: #145dbf;
            }

      
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 5px;
            margin: 20px 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-btn {
            border: none;
            padding: 8px 14px;
            background-color: #f0f0f0;
            color: #333;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .page-btn:hover {
                background-color: #4facfe; /* أزرق عند المرور */
                color: #fff;
            }

            .page-btn.active {
                background-color: #007bff; /* أزرق الصفحة الحالية */
                color: #fff;
            }

        #prev, #next {
            font-weight: bold;
        }

    </style>

