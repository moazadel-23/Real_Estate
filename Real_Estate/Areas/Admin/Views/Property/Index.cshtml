            <script>

                                const pageButtons = document.querySelectorAll('.page-btn');
                const prevBtn = document.getElementById('prev');
                const nextBtn = document.getElementById('next');

                let currentPage = 1;
                const totalPages = pageButtons.length - 2; // نطرح السهمين

                pageButtons.forEach((btn, index) => {
                    if (index !== 0 && index !== pageButtons.length -1) { // تجاهل السهمين
                        btn.addEventListener('click', () => {
                            pageButtons.forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                            currentPage = index;
                            console.log('Current Page:', currentPage);
                        });
                    }
                });

                prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                        pageButtons[currentPage].classList.remove('active');
                        currentPage--;
                        pageButtons[currentPage].classList.add('active');
                    }
                });

                nextBtn.addEventListener('click', () => {
                    if (currentPage < totalPages) {
                        pageButtons[currentPage].classList.remove('active');
                        currentPage++;
                        pageButtons[currentPage].classList.add('active');
                    }
                });

                function subscribeNewsletter(event) {
                    event.preventDefault();
                    const email = document.getElementById('newsletterEmail').value;
                    const msg = document.getElementById('newsletterMessage');

                    if(email) {
                        msg.textContent = `🎉 تم الاشتراك بنجاح: ${email}`;
                        msg.style.display = 'block';

                        // إعادة الرسالة مخفية بعد انتهاء الحركة
                        setTimeout(() => {
                            msg.style.display = 'none';
                        }, 3000);

                        document.getElementById('newsletterEmail').value = '';
                    }
                }
            </script>

