                </a>

                <a href="@Url.Action("Login", "Account", new { area = "Identity" })"
                   class="login-option-btn outline-btn"
                   style="
       border: 1px solid #e03c3c;
       color: #e03c3c;
       padding: 10px 15px;
       border-radius: 5px;
       background: none;
       text-decoration: none;
       display: inline-flex;
       align-items: center;
       justify-content: center;
       font-weight: 500;
       transition: all 0.3s;
       gap: 8px;
   "
                   onmouseover="this.style.background='#e03c3c'; this.style.color='#fff';"
                   onmouseout="this.style.background='none'; this.style.color='#e03c3c';">
                    <i class="fa-regular fa-envelope"></i> الدخول بالبريد الإلكتروني
                </a>

            </div>
            <div class="separator-text" style="text-align:center; margin:10px 0;">أو</div>
            <div class="social-login-options" style="display:flex; flex-direction:column; gap:15px; margin-top:20px; align-items: center;">
                <a href="/Account/ExternalLogin?provider=Google" class="social-btn google-btn">
                    <img src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" width="22" height="22">
                    <span>الدخول باستخدام Google</span>
                </a>

                <a href="/Account/ExternalLogin?provider=Facebook" class="social-btn facebook-btn">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/b/b9/2023_Facebook_icon.svg" width="22" height="22">
                    <span>الدخول باستخدام Facebook</span>
                </a>

            </div>

            <div class="modal-footer-text" style="text-align:center; margin-top:15px;">
                جديد في السكن الفاخر؟ <a href="Identity/Account/Register" style="color: #e03c3c;">إنشاء حساب جديد</a>
            </div>
        </div>
    </div>
  
    <script src="~/js/script.js"></script>
    <script>
        function openLoginModal() {
            document.getElementById('loginModal').style.display = 'flex';
        }
        function closeLoginModal() {
            document.getElementById('loginModal').style.display = 'none';
