@model Real_Estate.Models.ViewModel.ProfileVM
@{
    ViewData["Title"] = "الملف الشخصي";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الملف الشخصي - السكن الفاخر</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css">

    <style>
        .profile-header {
            background-color: var(--primary-color);
            padding: 100px 0 90px;
            color: white;
            text-align: center;
        }

        .profile-card {
            background: white;
            border-radius: 20px;
            max-width: 800px;
            margin: 20px auto 50px;
            padding: 40px;
        }

        .profile-img-container {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 5px solid white;
            overflow: hidden;
            margin: -115px auto 20px;
            cursor: pointer;
        }

        .profile-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .toast-notification {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(0, 0, 0, 0.85);
            color: white;
            padding: 15px 30px;
            border-radius: 50px;
            opacity: 0;
            transition: .5s;
            z-index: 9999;
        }

        .toast-notification.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    </style>
</head>

<body>

    <!-- Toast -->
    <div class="toast-notification" id="successToast">
        <i class="fa-solid fa-check"></i> تم حفظ التغييرات بنجاح
    </div>

    <!-- Header -->
    <div class="profile-header">
        <h2>إعدادات الحساب</h2>
        <p>قم بتحديث معلوماتك الشخصية</p>
    </div>

    <!-- Card -->
    <div class="container">
        <div class="profile-card">

            <div class="profile-img-container" onclick="document.getElementById('fileInput').click()">
                <img src="https://via.placeholder.com/150" class="profile-img" id="profilePreview">
                <input type="file" id="fileInput" hidden>
            </div>

            <h3 style="text-align:center;margin-bottom:30px">معلوماتي الشخصية</h3>

            <!-- FORM -->
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group">
                        <label>الاسم الأول</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>اسم العائلة</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <div class="form-group" style="grid-column:1/-1">
                        <label>العنوان</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                </div>

                <div style="margin-top:30px;text-align:center">
                    <button type="submit" class="btn btn-primary">
                        حفظ التغييرات
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        const fileInput = document.getElementById('fileInput');
        const profilePreview = document.getElementById('profilePreview');

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => profilePreview.src = e.target.result;
                reader.readAsDataURL(file);
            }
        });

        @if (TempData["Success"] != null)
        {
                <text>
                    const toast = document.getElementById('successToast');
                    toast.classList.add('show');
                    setTimeout(() => toast.classList.remove('show'), 3000);
                </text>
        }
    </script>

</body>
</html>
