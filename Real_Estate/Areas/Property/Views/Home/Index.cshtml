@model Real_Estate.Models.ViewModel.PropertyFilterVM
@using Real_Estate.Models
@{
    // Render this view as a standalone page (prevents double-layout HTML if _ViewStart sets a Layout).
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>السكن الفاخر - للعقارات المتميزة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="nav-right-group" style="display: flex; align-items: center;">
                <button class="desktop-menu-btn" onclick="toggleDesktopSidebar()" style="margin-left: 15px; font-size: 1.5rem; background: none; border: none; cursor: pointer; color: var(--primary-color);">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <a href="/Property/Home/Index" class="logo"><i class="fa-solid fa-city"></i> السكن<span>الفاخر</span></a>
            </div>
            <div class="nav-buttons" style="display: flex !important; align-items: center; gap: 20px;">
                <a href="/Property/Home/Favorites" title="المفضلة" style="font-size: 1.3rem; color: var(--primary-color);"><i class="fa-solid fa-heart"></i></a>
                <button id="themeToggle" onclick="toggleTheme()" style="background:none; border:none; cursor:pointer; font-size: 1.2rem; color: var(--primary-color);"><i class="fa-solid fa-moon"></i></button>
                <button id="langToggle" onclick="toggleLanguage()" style="background:none; border:none; cursor:pointer; font-size: 1rem; color: var(--primary-color); font-weight: bold; border: 1px solid var(--primary-color); border-radius: 5px; padding: 2px 8px;">EN</button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero" id="home">
        <div class="overlay"></div>
        <div class="hero-content">
            <h1 class="fade-in">اكتشف منزل أحلامك <br> بتصميم عصري وفخامة لا تضاهى</h1>
            <p class="fade-in delay-1">نوفر لك أفضل الخيارات العقارية في أرقى الأحياء السكنية</p>

            <!-- Search Form -->
            <div class="search-box fade-in delay-2">
                <form asp-controller="Home" asp-action="Index" method="get" id="searchForm">
                    <div class="search-wrapper">
                        <div class="input-container">
                            <i class="fa-solid fa-location-dot"></i>
                            <input type="text" asp-for="SearchLocation" placeholder="ابحث عن مدينتك...">
                        </div>
                        <div class="input-divider"></div>
                        <div class="input-container">
                            <i class="fa-solid fa-home"></i>
                            <select asp-for="PropertyType">
                                <option value="">كل الأنواع</option>
                                <option value="Apartment">شقة</option>
                                <option value="Villa">فيلا</option>
                                <option value="Office">مكتب</option>
                                <option value="Chalet">شاليه</option>
                                <option value="Palace">قصر</option>
                            </select>
                        </div>
                        <div class="input-divider"></div>
                        <div class="input-container">
                            <i class="fa-solid fa-dollar-sign"></i>
                            <select asp-for="MaxPrice">
                                <option value="">كل الأسعار</option>
                                <option value="1000000">أقل من 1 مليون</option>
                                <option value="3000000">1 - 3 مليون</option>
                                <option value="30000000">أكثر من 3 مليون</option>
                            </select>
                        </div>
                        <button type="submit" class="search-btn-icon"><i class="fa-solid fa-search"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </header>

    <!-- Featured Properties -->
    <section class="section" id="featured">
        <div class="container">
            <div class="section-header">
                <h2>عقارات مميزة</h2>
                <p>تصفح أحدث العقارات المضافة لدينا</p>
            </div>

            <div class="properties-grid" id="propertiesContainer">
                @if (Model.Properties != null && Model.Properties.Any())
                {
                    @foreach (var item in Model.Properties)
                    {
                        <div class="property-card">
                            <div class="card-image">
                                @if (!string.IsNullOrEmpty(item.MainImg))
                                {
                                    <img src="@item.MainImg" alt="@item.Title">
                                }
                                <div class="badge-type">@item.Type</div>
                                <button class="fav-btn"><i class="fa-solid fa-heart"></i></button>
                            </div>
                            <div class="card-content">
                                <div class="price">@item.Price.ToString("N0") ج.م</div>
                                <h3 class="title">@item.Title</h3>
                                <p class="location"><i class="fa-solid fa-location-dot"></i> @(item.Location?.City ?? "غير محدد")</p>
                                <div class="features">
                                    <span><i class="fa-solid fa-bed"></i> @item.Bedrooms</span>
                                    <span><i class="fa-solid fa-bath"></i> @item.Bathrooms</span>
                                    <span><i class="fa-solid fa-ruler-combined"></i> @item.AreaSize م²</span>
                                </div>
                                <a href="#" class="btn btn-outline" style="width:100%; margin-top:10px;">التفاصيل</a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p style="font-size:1.2rem; color:#777;">لا توجد عقارات مطابقة لبحثك حالياً.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <script src="~/js/script.js"></script>
</body>
</html>