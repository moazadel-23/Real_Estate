<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>السكن الفاخر - للعقارات المتميزة</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Main Style -->
    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="index.html" class="logo">
                <i class="fa-solid fa-city"></i> السكن<span>الفاخر</span>
            </a>
            <ul class="nav-links">
                <li><a href="#home" class="active">الرئيسية</a></li>
                <li><a href="#featured">العقارات</a></li>
                <li><a href="favorites.html">المفضلة</a></li>
                <li><a href="#services">خدماتنا</a></li>
                <li><a href="#contact">اتصل بنا</a></li>
            </ul>
            <div class="nav-buttons" style="display: flex !important; align-items: center; gap: 20px;">
                <a href="favorites.html" title="المفضلة" style="font-size: 1.3rem; color: var(--primary-color);">
                    <i class="fa-solid fa-heart"></i>
                </a>
                <a href="cart.html" title="السلة" style="font-size: 1.3rem; color: var(--primary-color);">
                    <i class="fa-solid fa-cart-shopping"></i>
                </a>
            </div>
            <div class="menu-toggle">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu">
        <ul class="mobile-nav-links">
            <li><a href="#home">الرئيسية</a></li>
            <li><a href="#featured">العقارات</a></li>
            <li><a href="favorites.html">المفضلة</a></li>
            <li><a href="#services">خدماتنا</a></li>
            <li><a href="#contact">اتصل بنا</a></li>
            <li><a href="cart.html">السلة</a></li>
        </ul>
    </div>

    <!-- Hero Section -->
    <header class="hero" id="home">
        <div class="overlay"></div>
        <div class="hero-content">
            <h1 class="fade-in">اكتشف منزل أحلامك <br> بتصميم عصري وفخامة لا تضاهى</h1>
            <p class="fade-in delay-1">نوفر لك أفضل الخيارات العقارية في أرقى الأحياء السكنية</p>

            <!-- Search Box -->
            <div class="search-box fade-in delay-2">
                <form id="searchForm">
                    <div class="input-group">
                        <i class="fa-solid fa-location-dot"></i>
                        <input type="text" placeholder="المدينة أو المنطقة...">
                    </div>
                    <div class="input-group">
                        <i class="fa-solid fa-home"></i>
                        <select>
                            <option value="">نوع العقار</option>
                            <option value="apartment">شقة</option>
                            <option value="villa">فيلا</option>
                            <option value="office">مكتب</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <i class="fa-solid fa-dollar-sign"></i>
                        <select>
                            <option value="">السعر</option>
                            <option value="low">أقل من 1 مليون</option>
                            <option value="medium">1 - 3 مليون</option>
                            <option value="high">أكثر من 3 مليون</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary search-btn">
                        <i class="fa-solid fa-search"></i>
                        بحث
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- Stats Section -->
    <section class="stats">
        <div class="container stats-container">
            <div class="stat-item">
                <h3 class="counter" data-target="1500">0</h3>
                <p>عقار مباع</p>
            </div>
            <div class="stat-item">
                <h3 class="counter" data-target="850">0</h3>
                <p>عميل سعيد</p>
            </div>
            <div class="stat-item">
                <h3 class="counter" data-target="50">0</h3>
                <p>مدينة</p>
            </div>
            <div class="stat-item">
                <h3 class="counter" data-target="15">0</h3>
                <p>سنة خبرة</p>
            </div>
        </div>
    </section>

    <!-- Featured Properties -->
    <section class="section" id="featured">
        <div class="container">
            <div class="section-header">
                <h2>عقارات مميزة</h2>
                <p>تصفح أحدث العقارات المضافة لدينا</p>
            </div>

            <div class="properties-grid" id="propertiesContainer">
                <!-- Properties will be injected here via JS -->
            </div>

            <div class="center-btn">
                <a href="#" class="btn btn-outline">عرض جميع العقارات</a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="section services-section" id="services">
        <div class="container">
            <div class="section-header">
                <h2>لماذا تختارنا؟</h2>
                <p>نقدم خدمات متكاملة لتلبية جميع احتياجاتك العقارية</p>
            </div>
            <div class="services-grid">
                <div class="service-card">
                    <div class="icon-box">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                    <h3>أفضل الأسعار</h3>
                    <p>نضمن لك الحصول على أفضل قيمة مقابل استثمارك العقاري.</p>
                </div>
                <div class="service-card">
                    <div class="icon-box">
                        <i class="fa-solid fa-file-contract"></i>
                    </div>
                    <h3>توثيق قانوني</h3>
                    <p>فريق قانوني مختص لضمان سلامة جميع الإجراءات والعقود.</p>
                </div>
                <div class="service-card">
                    <div class="icon-box">
                        <i class="fa-solid fa-headset"></i>
                    </div>
                    <h3>دعم متواصل</h3>
                    <p>فريق خدمة عملاء جاهز للرد على استفساراتكم على مدار الساعة.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta">
        <div class="container">
            <h2>هل لديك عقار ترغب في بيعه؟</h2>
            <p>سجل عقارك معنا اليوم واحصل على تقييم مجاني وفرصة للوصول لآلاف المشترين.</p>
            <a href="#" class="btn btn-primary">سجل عقارك الآن</a>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="section" id="contact">
        <div class="container">
            <div class="contact-wrapper">
                <div class="contact-info">
                    <h2>تواصل معنا</h2>
                    <p>نحن هنا لمساعدتك في إيجاد منزلك المثالي.</p>
                    <div class="info-item">
                        <i class="fa-solid fa-map-marker-alt"></i>
                        <span>الرياض، المملكة العربية السعودية</span>
                    </div>
                    <div class="info-item">
                        <i class="fa-solid fa-phone"></i>
                        <span>+966 50 000 0000</span>
                    </div>
                    <div class="info-item">
                        <i class="fa-solid fa-envelope"></i>
                        <span>info@luxuryhomes.com</span>
                    </div>
                </div>
                <div class="contact-form">
                    <form>
                        <div class="form-group">
                            <input type="text" placeholder="الاسم الكامل" required>
                        </div>
                        <div class="form-group">
                            <input type="email" placeholder="البريد الإلكتروني" required>
                        </div>
                        <div class="form-group">
                            <textarea placeholder="رسالتك..." rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary full-width">إرسال الرسالة</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container footer-container">
            <div class="footer-col">
                <h3>السكن الفاخر</h3>
                <p>منصتك الأولى للبحث عن العقارات الفاخرة والمتميزة في المنطقة.</p>
                <div class="social-links">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="#home">الرئيسية</a></li>
                    <li><a href="#featured">العقارات</a></li>
                    <li><a href="#services">الخدمات</a></li>
                    <li><a href="#contact">اتصل بنا</a></li>
                    <li><a href="admin.html" style="color: #666; font-size: 0.8rem;">لوحة المسؤول</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>النشرة البريدية</h3>
                <form class="newsletter">
                    <input type="email" placeholder="أدخل بريدك الإلكتروني">
                    <button type="submit"><i class="fa-solid fa-paper-plane"></i></button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 جميع الحقوق محفوظة - السكن الفاخر</p>
        </div>
    </footer>

    <script src="/js/script.js"></script>
</body>

</html>