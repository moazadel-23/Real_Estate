<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>لوحة التحكم - السكن الفاخر</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 280px;
            --primary-color: #283649;
            --accent-color: #4f46e5;
            --transition: 0.3s ease;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f4f6f9;
        }

        /* Sidebar */
        .admin-sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--primary-color);
            color: white;
            padding: 20px;
            overflow-y: auto;
            transition: var(--transition);
            z-index: 1000;
        }

        .sidebar-header {
            text-align: center;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }

            .sidebar-logo span {
                color: var(--accent-color);
            }

        .sidebar-menu {
            list-style: none;
            padding: 0;
        }

        .menu-item {
            margin-bottom: 5px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 15px;
            border-radius: 8px;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            cursor: pointer;
            transition: var(--transition);
        }

            .menu-link:hover,
            .menu-link.active {
                background-color: rgba(255, 255, 255, 0.1);
                color: white;
            }

            .menu-link span {
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .menu-arrow {
            font-size: 0.8rem;
            transition: transform 0.3s ease;
        }

        .submenu {
            list-style: none;
            padding-right: 35px;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }

            .submenu.open {
                max-height: 500px;
            }

        .submenu-item {
            margin: 5px 0;
        }

        .submenu-link {
            display: block;
            padding: 8px 10px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            text-decoration: none;
            border-radius: 5px;
            transition: var(--transition);
        }

            .submenu-link:hover {
                color: var(--accent-color);
                background: rgba(255, 255, 255, 0.05);
            }

        .menu-link.expanded .menu-arrow {
            transform: rotate(-90deg);
        }

        /* Main Content */
        .main-content {
            margin-right: var(--sidebar-width);
            padding: 30px;
            transition: margin-right 0.3s ease;
        }

            .admin-sidebar {
                transform: translateX(100%);
            }

            .main-content {
                margin-right: 0;
            }

            .admin-sidebar.active {
                transform: translateX(0);
            }

            .sidebar-toggle-btn {
                display: block;
            }
        

        .sidebar-toggle-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1001;
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            border: 2px solid white;
            display: none;
            cursor: pointer;
        }

        .dashboard-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <!-- Toggle Button -->
    <button class="sidebar-toggle-btn" onclick="toggleSidebar()">
        <i class="fa-solid fa-bars"></i>
    </button>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="admin-dashboard.html" class="sidebar-logo">
                <i class="fa-solid fa-city"></i> السكن<span>الفاخر</span>
            </a>
            <p style="font-size: 0.8rem; margin-top: 5px; opacity: 0.7;">لوحة تحكم الإدارة</p>
        </div>

        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="@Url.Action("Index")" class="menu-link active">
                    <span><i class="fa-solid fa-gauge-high"></i> الصفحة الرئيسية</span>
                </a>
            </li>

            <li class="menu-item">
                <a href="javascript:void(0)" class="menu-link" onclick="toggleSubmenu(this)">
                    <span><i class="fa-solid fa-building"></i> العقارات</span>
                    <i class="fa-solid fa-chevron-left menu-arrow"></i>
                </a>
                <ul class="submenu">
                    <li class="submenu-item">
                        <a href="@Url.Action("board", "Property", new { area = "Admin" })"
                           class="submenu-link">
                            <i class="fa-solid fa-plus-circle"></i>
                            <span>إدارة العقارات</span>
                        </a>
                    </li>
                    <li class="submenu-item">
                        <a href="@Url.Action("Create", "Property", new { area = "Admin" })"
                           class="submenu-link">
                            <i class="fa-solid fa-plus-circle"></i>
                            <span>إضافة عقار</span>
                        </a>
                    </li>
                </ul>
            </li>

          
            <li class="menu-item">
                <a href="#" class="menu-link">
                    <span><i class="fa-solid fa-right-from-bracket"></i> تسجيل خروج</span>
                </a>
            </li>
        </ul>
    </aside>


    <!-- Main Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script>
        function toggleSubmenu(element) {
            const submenu = element.nextElementSibling;
            element.classList.toggle('expanded');
            submenu.classList.toggle('open');
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }
    </script>
</body>

</html>